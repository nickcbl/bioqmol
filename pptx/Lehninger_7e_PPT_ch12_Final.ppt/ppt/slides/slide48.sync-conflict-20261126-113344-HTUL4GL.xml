bri"/><a:ea typeface="Calibri"/><a:cs typeface="Calibri"/><a:sym typeface="Calibri"/></a:rPr><a:t>Direct Regulation of Transcription </a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" marR="0" rtl="0" algn="ctr"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:srgbClr val="2FB0DC"/></a:buClr><a:buSzPts val="4000"/><a:buFont typeface="Calibri"/><a:buNone/></a:pPr><a:r><a:rPr b="1" i="0" lang="en-US" sz="4000" u="none"><a:solidFill><a:srgbClr val="2FB0DC"/></a:solidFill><a:latin typeface="Calibri"/><a:ea typeface="Calibri"/><a:cs typeface="Calibri"/><a:sym typeface="Calibri"/></a:rPr><a:t>by Hormones</a:t></a:r><a:endParaRPr/></a:p></p:txBody></p:sp><p:cxnSp><p:nvCxnSpPr><p:cNvPr id="466" name="Google Shape;466;p62"/><p:cNvCxnSpPr/><p:nvPr/></p:nvCxnSpPr><p:spPr><a:xfrm><a:off x="457200" y="1371600"/><a:ext cx="8229600" cy="0"/></a:xfrm><a:prstGeom prst="straightConnector1"><a:avLst/></a:prstGeom><a:noFill/><a:ln cap="flat" cmpd="thinThick" w="57150"><a:solidFill><a:srgbClr val="2FB0DC"/></a:solidFill><a:prstDash val="solid"/><a:miter lim="800000"/><a:headEnd len="med" w="med" type="none"/><a:tailEnd len="med" w="med" type="none"/></a:ln></p:spPr></p:cxnSp><p:pic><p:nvPicPr><p:cNvPr descr="Diagram illustrating the general mechanism by which steroid and thyroid hormones, retinoids, and vitamin D regulate gene expression.&#xA;The mechanism occurs in the cytosol, which is outlined by the plasma membrane. This diagram has four parts. In the first part, two pinkish structures are shown, with an arrow pointing from the bottom of one to the other. The pinkish structures are serum binding proteins - the one on top is bound to a hormone while the one on the bottom has an empty binding sit. The hormone is shown leaving the top serum binding protein and entering the nucleus of the cell, where it binds into two green structures that represent the nuclear receptors. The nuclear receptors are bound to a yello structure, which is RNA polymerase - this structure is connected to a long line that starts out yellow from the right and turns blue on the left. The blue part is DNA and the yellow part is HRE. At the bottom of the RNA polymerase is a small hanging piece, which is labeled &quot;Gene.&quot; An arrow pointing downward from the gene is labeled &quot;transcription,&quot; and below that is a green wave labeled mRNA. From mRNA, another curved arrow pointing to the left (outside the nucleus) is labeled &quot;translation of ribosomes.&quot; Next to it, there a longer mRNA passing through two pink structures that have purple gumdrop-like structures on top and little tails on the bottom. From these structures, a curved arrow is shown pointing upward to a new protein (purple oval) - the tip of the arrow is labeled &quot;altered cell function.&quot; " id="467" name="Google Shape;467;p62"/><p:cNvPicPr preferRelativeResize="0"/><p:nvPr/></p:nvPicPr><p:blipFill rotWithShape="1"><a:blip r:embed="rId3"><a:alphaModFix/></a:blip><a:srcRect b="0" l="0" r="0" t="0"/><a:stretch/></p:blipFill><p:spPr><a:xfrm><a:off x="1524000" y="1589087"/><a:ext cx="6281737" cy="5135562"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></p:spPr></p:pic></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>