bri"/><a:ea typeface="Calibri"/><a:cs typeface="Calibri"/><a:sym typeface="Calibri"/></a:rPr><a:t>Isomerization in Propionate Oxidation Requires Coenzyme B</a:t></a:r><a:r><a:rPr b="1" baseline="-25000" i="0" lang="en-US" sz="4000" u="none"><a:solidFill><a:srgbClr val="2FB0DC"/></a:solidFill><a:latin typeface="Calibri"/><a:ea typeface="Calibri"/><a:cs typeface="Calibri"/><a:sym typeface="Calibri"/></a:rPr><a:t>12</a:t></a:r><a:endParaRPr/></a:p></p:txBody></p:sp><p:cxnSp><p:nvCxnSpPr><p:cNvPr id="422" name="Google Shape;422;p58"/><p:cNvCxnSpPr/><p:nvPr/></p:nvCxnSpPr><p:spPr><a:xfrm><a:off x="457200" y="1371600"/><a:ext cx="8229600" cy="0"/></a:xfrm><a:prstGeom prst="straightConnector1"><a:avLst/></a:prstGeom><a:noFill/><a:ln cap="flat" cmpd="thinThick" w="57150"><a:solidFill><a:srgbClr val="2FB0DC"/></a:solidFill><a:prstDash val="solid"/><a:miter lim="800000"/><a:headEnd len="med" w="med" type="none"/><a:tailEnd len="med" w="med" type="none"/></a:ln></p:spPr></p:cxnSp><p:pic><p:nvPicPr><p:cNvPr descr="Two images illustrating the methylmalonyl-CoA mutase reaction. &#xA;Image (a) begins with L-methylmalonyl-CoA, where H bonds right to C, which bonds up to H, down to H (in red box) and right to C. C bonds up to H and down to C, which double bonds down and left to O and bonds down and right to S-CoA (C, O, and S-CoA are in a blue box). The second C also bonds right to C, which double bonds up and right to O and down and right to O-. To the right of this are reversible arrows, with coenzyme B12 on top of the arrows and methylmalonyl-CoA mutase (in blue) below. To the right of the arrows is succinyl-CoA, where H bonds right to C, which bonds up to H and down to C, which double bonds down and left to O and down and right to S-CoA (C, O, and S-CoA are in a blue box). The first C also bonds right to C, which bonds up to H, down to H (in a red box) and right to C, which double bonds up and right to O and down and right to O-. Image (b) begins with C bonding up and left to nothing, down to H (in a red box) and right to C. This C bonds up and right to nothing and down to X (in a blue box). Reversible arrows are to the right of this, with coenzyme B12 on top. To the right of the arrows is the exact reverse of the first molecule.&#xA;" id="423" name="Google Shape;423;p58"/><p:cNvPicPr preferRelativeResize="0"/><p:nvPr/></p:nvPicPr><p:blipFill rotWithShape="1"><a:blip r:embed="rId3"><a:alphaModFix/></a:blip><a:srcRect b="0" l="0" r="0" t="0"/><a:stretch/></p:blipFill><p:spPr><a:xfrm><a:off x="304800" y="1570037"/><a:ext cx="8534400" cy="4754562"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></p:spPr></p:pic></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>