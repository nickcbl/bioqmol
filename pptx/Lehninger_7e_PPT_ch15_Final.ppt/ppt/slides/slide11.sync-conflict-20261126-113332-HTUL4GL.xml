 val="dk1"/></a:solidFill><a:latin typeface="Calibri"/><a:ea typeface="Calibri"/><a:cs typeface="Calibri"/><a:sym typeface="Calibri"/></a:rPr><a:t>K</a:t></a:r><a:r><a:rPr b="0" baseline="-25000" i="0" lang="en-US" sz="2800" u="none" cap="none" strike="noStrike"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Calibri"/><a:ea typeface="Calibri"/><a:cs typeface="Calibri"/><a:sym typeface="Calibri"/></a:rPr><a:t>m</a:t></a:r><a:r><a:rPr b="0" i="0" lang="en-US" sz="2800" u="none" cap="none" strike="noStrike"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Calibri"/><a:ea typeface="Calibri"/><a:cs typeface="Calibri"/><a:sym typeface="Calibri"/></a:rPr><a:t> that is near or greater than the physiological concentration of their substrate.</a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="-285750" lvl="1" marL="742950" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="480"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:schemeClr val="dk1"/></a:buClr><a:buSzPts val="2400"/><a:buFont typeface="Calibri"/><a:buChar char="–"/></a:pPr><a:r><a:rPr b="0" i="0" lang="en-US" sz="2400" u="none" cap="none" strike="noStrike"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Calibri"/><a:ea typeface="Calibri"/><a:cs typeface="Calibri"/><a:sym typeface="Calibri"/></a:rPr><a:t>especially those utilizing ATP, or NAD(H)</a:t></a:r><a:endParaRPr/></a:p></p:txBody></p:sp><p:cxnSp><p:nvCxnSpPr><p:cNvPr id="183" name="Google Shape;183;p25"/><p:cNvCxnSpPr/><p:nvPr/></p:nvCxnSpPr><p:spPr><a:xfrm><a:off x="457200" y="762000"/><a:ext cx="8229600" cy="0"/></a:xfrm><a:prstGeom prst="straightConnector1"><a:avLst/></a:prstGeom><a:noFill/><a:ln cap="flat" cmpd="thinThick" w="57150"><a:solidFill><a:srgbClr val="2FB0DC"/></a:solidFill><a:prstDash val="solid"/><a:miter lim="800000"/><a:headEnd len="med" w="med" type="none"/><a:tailEnd len="med" w="med" type="none"/></a:ln></p:spPr></p:cxnSp><p:pic><p:nvPicPr><p:cNvPr descr="A chart illustrating measured metabolite concentrations for E. coli growing on glucose plotted against the known Km for enzymes that consume the metabolite. The vertical axis represents metabolite concentration (M), with markers at 10-8, 10-6, 10-4, 10-2, and 100.  The horizontal axis represents Km(M), with the same markers as the vertical axis. There is a solid line, which represents the line of unity (where metabolite concentration = Km), beginning at the 10-8 and 10-8 point and goes up to the 100 and 100 points. Two dashed lines, representing a tenfold deviation from the line of unity, are on either side of the line of unity. At the vertical 10-4 and horizontal 10-6 mark, there is a small blue boxed line, followed by a longer blue boxed line and a blue box; these extend to the 10-4 horizontal mark and represent NADPH. Just below the vertical 10-2 mark and at the 10-6 horizontal mark, there is an orange box, presenting NAD plus. To the right of that, at approximately halfway between the 10-6 and 10-4 horizontal marks are two NAD plus boxes, followed by two more boxed lines, extending to about halfway between the 10-4 and 10-2 horizontal marks. At the 10-2 vertical mark and halfway between the 10-8 and 10-6 horizontal mark is an orange box, representing ATP. To the right of that is a solid orange boxed line, which begins at horizontal 10-6 and ends at approximately 10-2. Degradation reactions, represented by small orange circles are peppered through this diagram, but mostly below the unity line. Central pathways of carbon metabolism, represented with dark green circles are concentrated between the vertical 10-6 and 10-2 marks and beginning halfway between the horizontal 10-6 and 10-4 marks extending to approximately the 10-2 mark. Other concentrations are represented by a green diamond and are also peppered throughout the graph." id="184" name="Google Shape;184;p25"/><p:cNvPicPr preferRelativeResize="0"/><p:nvPr/></p:nvPicPr><p:blipFill rotWithShape="1"><a:blip r:embed="rId3"><a:alphaModFix/></a:blip><a:srcRect b="0" l="0" r="0" t="0"/><a:stretch/></p:blipFill><p:spPr><a:xfrm><a:off x="2247900" y="2303462"/><a:ext cx="4648200" cy="4429125"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></p:spPr></p:pic></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>