libri"/><a:ea typeface="Calibri"/><a:cs typeface="Calibri"/><a:sym typeface="Calibri"/></a:rPr><a:t>ABC Transporters Use ATP Hydrolysis </a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" marR="0" rtl="0" algn="ctr"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:srgbClr val="2FB0DC"/></a:buClr><a:buSzPts val="4000"/><a:buFont typeface="Calibri"/><a:buNone/></a:pPr><a:r><a:rPr b="1" i="0" lang="en-US" sz="4000" u="none"><a:solidFill><a:srgbClr val="2FB0DC"/></a:solidFill><a:latin typeface="Calibri"/><a:ea typeface="Calibri"/><a:cs typeface="Calibri"/><a:sym typeface="Calibri"/></a:rPr><a:t>to Drive Transport of Substrates</a:t></a:r><a:endParaRPr/></a:p></p:txBody></p:sp><p:cxnSp><p:nvCxnSpPr><p:cNvPr id="599" name="Google Shape;599;p81"/><p:cNvCxnSpPr/><p:nvPr/></p:nvCxnSpPr><p:spPr><a:xfrm><a:off x="457200" y="1447800"/><a:ext cx="8229600" cy="0"/></a:xfrm><a:prstGeom prst="straightConnector1"><a:avLst/></a:prstGeom><a:noFill/><a:ln cap="flat" cmpd="thinThick" w="57150"><a:solidFill><a:srgbClr val="2FB0DC"/></a:solidFill><a:prstDash val="solid"/><a:miter lim="800000"/><a:headEnd len="med" w="med" type="none"/><a:tailEnd len="med" w="med" type="none"/></a:ln></p:spPr></p:cxnSp><p:pic><p:nvPicPr><p:cNvPr descr="A diagram showing a proposed mechanism for how ABC transporters work. The area above the cell membrane is labeled extracellular space; the area below the cell membrane is labeled cytoplasm. The protein on the left end of the membrane is labeled outward-facing above the image. The TMDs are represented by a pale blue cylinder on the left and a purple cylinder on the right. Their cytoplasm ends are together and their ECF ends are open, with a green ball labeled “substrate” shown entering the space between. The 2 NDBs are light red spheres bonded to the bottoms of the TMDs; there are 2 ATP molecules, represented by orange ovals, between them. All of these elements are labeled below. To the right is the inward facing model, where the ECF ends of the TMDs are together and closed, so no substrate can enter. The cytoplasm ends of the TMDs, however, are apart. There is a green ball representing substrate between the two TMDs on the cytoplasm side, indicating that it has been transported into the cell by the ABC transporter. Two gray circles on the NDBs are labeled ADP." id="600" name="Google Shape;600;p81"/><p:cNvPicPr preferRelativeResize="0"/><p:nvPr/></p:nvPicPr><p:blipFill rotWithShape="1"><a:blip r:embed="rId3"><a:alphaModFix/></a:blip><a:srcRect b="0" l="0" r="0" t="0"/><a:stretch/></p:blipFill><p:spPr><a:xfrm><a:off x="304800" y="1676400"/><a:ext cx="8534400" cy="4572000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></p:spPr></p:pic></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>